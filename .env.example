# Database Configuration
DB_URL=postgresql://postgres:password@localhost:5432/database_name?sslmode=disable

# JWT Configuration - Use a strong secret in production
JWT_SECRET=your_jwt_secret_here
JWT_ACCESS_TOKEN_EXPIRY=8h  # 8 hours
JWT_REFRESH_TOKEN_EXPIRY=168h  # 7 days

# Server Configuration
PORT=4000
GIN_MODE=debug
ALLOWED_ORIGINS=http://localhost:3000,https://your-production-domain.com

# AI ApiKey
OPENROUTER_API_KEY=your_openrouter_api_key_here
